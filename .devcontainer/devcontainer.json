{
  "name": "Next.js Dev Container",

  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Next.js App",
      "onAutoForward": "openBrowser"
    }
  },

  // Install project dependencies and Claude Code CLI
  "postCreateCommand": "npm install && npm install -g @anthropic-ai/claude-code",

  "postStartCommand": "printf '\\n  Next.js dev server starting...\\n  Local: http://localhost:3000\\n\\n' && npm run dev",

  // macOS Docker bind mounts don't emit inotify events — polling is required.
  // ANTHROPIC_API_KEY is read from your Mac's shell environment (~/.zshrc).
  "remoteEnv": {
    "WATCHPACK_POLLING": "true",
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  },

  // Persist Claude Code conversations and memory across container rebuilds.
  // The named volume lives outside the container and survives rebuilds.
  "mounts": [
    "source=nextjs-container-claude,target=/home/node/.claude,type=volume"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "formulahendry.auto-rename-tag",
        "christian-kohler.path-intellisense"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 2
      }
    }
  }
}
