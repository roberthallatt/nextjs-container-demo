{
  "name": "Next.js Dev Container",

  // Switch from a single image to Docker Compose so we can run
  // a Caddy reverse proxy alongside the Next.js app.
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",

  // Runs on the HOST Mac before the container builds.
  // Adds a /etc/hosts entry so http://nextjs-demo.test resolves to 127.0.0.1.
  // The grep check makes this idempotent — only prompts for sudo once.
  "initializeCommand": "grep -q 'nextjs-demo.test' /etc/hosts || echo '127.0.0.1  nextjs-demo.test' | sudo tee -a /etc/hosts > /dev/null",

  // Install dependencies after the container is created
  "postCreateCommand": "npm install",

  // Start the dev server when the container starts
  "postStartCommand": "npm run dev",

  // Forward port 3000 for direct access alongside the Caddy proxy on port 80.
  // Port 80 is published directly by the Caddy container via docker-compose.yml
  // so VS Code doesn't need to manage it.
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Next.js (direct)",
      "onAutoForward": "silent"
    }
  },

  // macOS Docker bind mounts don't emit inotify events — polling is required
  "remoteEnv": {
    "WATCHPACK_POLLING": "true"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "formulahendry.auto-rename-tag",
        "christian-kohler.path-intellisense"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 2
      }
    }
  }
}
